# Quorum AI Backend Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AI Configuration
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# =============================================================================
# Agent Private Key (Encrypted V3 Keystore Support)
# =============================================================================
# If your ethereum_private_key.txt contains an encrypted V3 Keystore JSON,
# set this password to decrypt it. Leave empty for plaintext keys.
# AGENT_PASSWORD=your_secure_password_here

# =============================================================================
# Blockchain Configuration
# =============================================================================
BASE_RPC_URL=https://mainnet.base.org
# BASE_LEDGER_RPC=https://mainnet.base.org
# ETHEREUM_LEDGER_RPC=https://eth-mainnet.g.alchemy.com/v2/your-key
# GNOSIS_LEDGER_RPC=https://rpc.gnosischain.com
# MODE_LEDGER_RPC=https://mainnet.mode.network

# Chain ID (8453 for Base mainnet)
CHAIN_ID=8453

# =============================================================================
# Safe Wallet Configuration
# =============================================================================
# JSON format: {"base": "0x...", "gnosis": "0x..."}
# Or comma-separated: base:0x...,gnosis:0x...
SAFE_CONTRACT_ADDRESSES={"base": "0xYourSafeAddressHere"}

# =============================================================================
# EAS (Ethereum Attestation Service) Configuration
# =============================================================================
EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021
EAS_SCHEMA_UID=0xc93c2cd5d2027a300cc7ca3d22b36b5581353f6dabab6e14eb41daf76d5b0eb4

# Optional: AttestationTracker wrapper contract
# ATTESTATION_TRACKER_ADDRESS=0x08E7C36CDC1649428c6a056B8465d478ADE0Fae8

# =============================================================================
# Snapshot Configuration
# =============================================================================
SNAPSHOT_GRAPHQL_ENDPOINT=https://hub.snapshot.org/graphql
SNAPSHOT_HUB_URL=https://seq.snapshot.org/

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE_PATH=/app/store/logs/pearl/log.txt

# =============================================================================
# Testing/Development
# =============================================================================
# Enable mock mode to stub AI and blockchain calls
# MOCK_MODE=false
